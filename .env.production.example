# Omnipath production environment template
# Copy this file outside source control and inject real values through the
# deployment secret manager. Never commit the populated environment file.

APP_NAME=Omnipath
ENVIRONMENT=production
DEBUG=False

# Generate independent values with a cryptographically secure secret generator.
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_characters
JWT_SECRET_KEY=CHANGE_ME_generate_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Container/service DNS names are examples. Replace credentials through the
# deployment secret manager without committing them here.
DATABASE_URL=postgresql://omnipath:CHANGE_ME@postgres:5432/omnipath
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
NATS_URL=nats://omnipath:CHANGE_ME@nats:4222
NATS_ENABLED=True

OTEL_ENABLED=True
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=True
OTEL_METRICS_ENABLED=False
PROMETHEUS_ENABLED=True

CORS_ORIGINS=["https://example.com"]
CORS_ALLOW_CREDENTIALS=True

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
